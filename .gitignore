# Claude
.claude

# Byte-compiled
__pycache__/
*.py[codz]

# Environments
#   .env holds real credentials; .env.example is the committed template.
.env
.venv

# uv
#   uv.toml holds the Artifactory index URLs with embedded credentials, so it is NOT
#   committed — uv.toml.example is the template. uv.lock IS committed (regenerate with
#   `uv lock` somewhere with Artifactory access).
uv.toml

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
