# --- Bitbucket (the GitOps repo holding the Vault values files) ---
BITBUCKET_URL=https://bitbucket.app.com
BITBUCKET_TOKEN=bitbucket_http_access_token
VAULT_VALUES_REPO_PROJECT_KEY=INFRA
VAULT_VALUES_REPO_SLUG=vault-values
VAULT_VALUES_REPO_BASE_BRANCH=master
VAULT_VALUES_DIR=kv

# --- CI gates ---
# There is nothing to configure for the CI server. The gates read the build statuses the
# pipelines post *into Bitbucket* — the pull request's Builds tab — so Bitbucket is the
# only upstream, and the token above is the only credential.
#
# How the API waits on those builds. The create request blocks for the whole chain, so
# keep any proxy/ingress read timeout in front of this service above
# CI_PIPELINE_START_TIMEOUT_SECONDS + 2 * CI_PIPELINE_TIMEOUT_SECONDS.
CI_POLL_INTERVAL_SECONDS=5
CI_PIPELINE_START_TIMEOUT_SECONDS=120
CI_PIPELINE_TIMEOUT_SECONDS=900

# --- Pull request shaping ---
BRANCH_PREFIX=vault-kv
# Bitbucket usernames added as reviewers on every opened PR.
PR_REVIEWERS=["alice","bob"]

# --- Inbound auth — GLOBAL ---
# The app is built with general_create_app(enable_auth=True), so the library's
# AuthMiddleware protects EVERY route (except /docs, /metrics, /health, /openapi.json,
# /static, probes) once BOTH are true:
#   1) AUTH_ENABLED=true          # master switch; off by default, app boots open
#   2) exactly ONE verification material below is set
# Enabling with no material set fails app creation (fail-fast).
# AUTH_ENABLED=true
#   AUTH_HS256_SECRET=shared-secret                                 # symmetric HS256
#   AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json     # RS256 via JWKS
#   AUTH_OIDC_ISSUER=https://sso.platform.example/realms/platform   # JWKS via OIDC discovery
#   AUTH_PUBLIC_KEY_PEM / AUTH_PUBLIC_KEY_PATH                      # offline RS256
# AUTH_AUDIENCE=vault-api
# AUTH_ISSUER=https://idp.example.com/
# AUTH_EXCLUDE_PATHS=["/health","/metrics"]     # optional; extends the default excludes
